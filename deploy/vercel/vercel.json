{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "https://YOUR-FUNNEL-HOST/mcp" },
    { "source": "/mcp/:path*", "destination": "https://YOUR-FUNNEL-HOST/mcp/:path*" },
    { "source": "/.well-known/:path*", "destination": "https://YOUR-FUNNEL-HOST/.well-known/:path*" },
    { "source": "/authorize", "destination": "https://YOUR-FUNNEL-HOST/authorize" },
    { "source": "/token", "destination": "https://YOUR-FUNNEL-HOST/token" },
    { "source": "/register", "destination": "https://YOUR-FUNNEL-HOST/register" },
    { "source": "/revoke", "destination": "https://YOUR-FUNNEL-HOST/revoke" },
    { "source": "/consent", "destination": "https://YOUR-FUNNEL-HOST/consent" },
    { "source": "/", "destination": "https://YOUR-PAGES-HOST/YOUR-REPO/" },
    { "source": "/:path*", "destination": "https://YOUR-PAGES-HOST/YOUR-REPO/:path*" }
  ]
}
